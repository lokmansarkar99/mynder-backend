# Local development configuration. Copy this file to .env and replace the
# credential placeholders with your own values before using integrations.

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
RESPONSE_MODE=STRICT

# MongoDB
DATABASE_URL=mongodb://127.0.0.1:27017/mynder

# Authentication and password hashing
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_EXPIRE_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret
JWT_REFRESH_EXPIRE_IN=7d

# Initial administrator account (created when the database has no admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-local-admin-password

# SMTP email (the app currently uses a secure SMTP connection)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
EMAIL_FROM=no-reply@example.com

# Global API rate limit
EXPRESS_RATE_LIMIT=200
EXPRESS_RATE_LIMIT_IN_MINUTES=15

# Stripe. Use test-mode credentials during development.
STRIPE_SECRET_KEY=sk_test_replace_with_your_stripe_secret_key
STRIPE_API_KEY=pk_test_replace_with_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_stripe_webhook_secret
STRIPE_SUCCESS_URL=http://localhost:3000/payment/success
STRIPE_CANCEL_URL=http://localhost:3000/payment/cancel

# Google OAuth. Register this callback URL in the Google OAuth client.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Payment fee settings (amount is in the app's currency units; percent is a percentage)
PROCESSING_FEE=0
PLATFORM_FEE_PERCENT=10
